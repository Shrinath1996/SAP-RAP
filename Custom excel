         zinvoiceid                    TYPE string,
         zinvoicetype                  TYPE string,
         zfreightordinv                TYPE string,
         companycode                   TYPE string,
         supplierinvoicetransaction    TYPE string,
         invoicingparty                TYPE string,
         zinfoflovendor                TYPE string,
         supplierinvoiceidbyinvcgparty TYPE string,
         zrequesterid                  TYPE string,
         documentdate                  TYPE string,
         documentcurrency              TYPE string,
         invoicegrossamount            TYPE string,
         zponumber_header              TYPE string,
         zfreightorder                 TYPE string,
         zbol                          TYPE string,
         zprobill                      TYPE string,
         zwaybill                      TYPE string,
         unplanneddeliverycosttaxcode  TYPE string,
         zponumber_line                TYPE string,
         zfreightorder_line            TYPE string,
         zbol_line                     TYPE string,
         zprobill_line                 TYPE string,
         zwaybill_line                 TYPE string,
         zpoitemnum                    TYPE string,
         zpoquantity                   TYPE string,
         zpouom                        TYPE string,
         zponetprice                   TYPE string,
         glaccount                     TYPE string,
         supplierinvoiceitemtext       TYPE string,
         costcenter                    TYPE string,
         wbselement                    TYPE string,
         debitcreditcode               TYPE string,
         supplierinvoiceitemamount     TYPE string,
         taxcode                       TYPE string,
         taxjurisdiction               TYPE string,
       END OF ts_download_temp.

DATA: gt_data                 TYPE STANDARD TABLE OF ts_download_temp,
      lt_final                TYPE if_salv_export_appendix=>yts_cell,
      lt_blocks               TYPE if_salv_export_appendix=>yts_block,
      ls_formatting           TYPE if_salv_export_appendix=>ys_cell_formatting,
      lo_table_row_descriptor TYPE REF TO cl_abap_structdescr,
      lo_source_table_descr   TYPE REF TO cl_abap_tabledescr,
      1r_appendix             TYPE REF TO if_salv_export_appendix=>yts_block,
      lo_xml_document         TYPE REF TO cl_xml_document,
      lv_font_title           TYPE string,
      lv_font_info            TYPE string,
      lv_font_all             TYPE string,
      lv_style_all            TYPE string,
      lv_title_style          TYPE string,
      lv_info_style           TYPE string,
      lv_text_style           TYPE string,
      lv_date_style           TYPE string,
      lv_item                 TYPE i,
      lv_file_filter          TYPE string,
      lv_filename             TYPE string,
      lv_path                 TYPE string,
      lv_fullpath             TYPE string,
      lv_length               TYPE i,
      ev_user_action          TYPE i,
      lt_bintab               TYPE solix_tab,
      lv_date                 TYPE char10.

START-OF-SELECTION.

  GET REFERENCE OF gt_data INTO DATA(lo_excel_structure_1).
  DATA(lo_itab_services) = cl_salv_itab_services=>create_for_table_ref( lo_excel_structure_1 ).
  lo_source_table_descr ?= cl_abap_tabledescr=>describe_by_data_ref( lo_excel_structure_1 ).
  lo_table_row_descriptor ?= lo_source_table_descr->get_table_line_type( ).

  DATA(gt_field_lst) = lo_table_row_descriptor->components[].

  DATA(lo_tool_xls) = cl_salv_export_tool_ats_xls=>create_for_excel_from_ats(
  io_itab_services = lo_itab_services
  io_source_struct_descr = lo_table_row_descriptor
  it_aggregation_rules = VALUE if_salv_service_types=>yt_aggregation_rule( )
  it_grouping_rules = VALUE if_salv_service_types=>yt_grouping_rule( ) ).

  DATA(lo_config) = lo_tool_xls->configuration( ).
  ls_formatting-horizontal_alignment = '04'.
  ls_formatting-vertical_alignment = '03'.
  ls_formatting-is_bold = abap_true.
  ls_formatting-is_text_wrapping_enabled = abap_true.

  CALL FUNCTION 'HRGPBS_HESA_DATE_FORMAT'
    EXPORTING
      p_date     = sy-datum
    IMPORTING
      datestring = lv_date.

  APPEND VALUE #( row_index    = 1      column_index = 1 column_span = 2
                  content_type = 'TEXT' value        = 'Excel Invoice Fiori Upload' ) TO lt_final.
  APPEND VALUE #( row_index  = 2             column_index = 1 column_span = 1 content_type = 'TEXT'
                  formatting = ls_formatting value        = 'Last Updated:' ) TO lt_final.
  APPEND VALUE #( row_index  = 2             column_index = 2 column_span = 1 content_type = 'TEXT'
                  formatting = ls_formatting value        = lv_date ) TO lt_final.

  CLEAR ls_formatting-background_color.
  ls_formatting-background_color = 'FF8EA9DB'. "'#8EA9DB'
  APPEND VALUE #( row_index  = 4             column_index = 1 column_span = 18 content_type = 'TEXT'
                  formatting = ls_formatting value        = 'Header Data' ) TO lt_final.
  CLEAR ls_formatting-background_color.
  ls_formatting-background_color = 'FFED7D31'. "'#ED7D31'
  APPEND VALUE #( row_index  = 4             column_index = 19 column_span = 17 content_type = 'TEXT'
                  formatting = ls_formatting value        = 'Line Item Detail' ) TO lt_final.

  LOOP AT gt_field_lst INTO DATA(ls_field).
    CLEAR ls_formatting-background_color.
    IF sy-tabix < 19.
      ls_formatting-background_color = 'FFEDF1F9'.
    ELSE.
      ls_formatting-background_color = 'FFFCE4D6'.
    ENDIF.
    APPEND VALUE #( row_index    = 5      column_index = sy-tabix      row_span = 2 column_span = 1
                    content_type = 'TEXT' formatting   = ls_formatting value    = ls_field-name ) TO lt_final.
  ENDLOOP.

  APPEND VALUE #( ordinal_number = 1 location = 'TOP' name = 'Template_Title' cells = lt_final ) TO lt_blocks.

  GET REFERENCE OF lt_blocks INTO 1r_appendix.

  lo_config->if_salv_export_appendix~set_blocks( 1r_appendix ).
  TRY.
      lo_tool_xls->read_result( IMPORTING content = DATA(lv_content) ).
    CATCH cx_salv_export_error.
  ENDTRY.

  TRY.
      DATA(lo_xlsx_doc) = cl_xlsx_document=>load_document( lv_content ).
    CATCH cx_openxml_format.
  ENDTRY.

